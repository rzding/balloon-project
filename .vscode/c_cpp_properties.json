      "defines": [
        "USE_HAL_DRIVER",
        "STM32F411xE"
      ],
      "compilerPath": "arm-none-eabi-gcc",
      "cStandard": "c11",
      "intelliSenseMode": "gcc-arm",
      "compileCommands": "${workspaceFolder}/balloon-project-stm32mx/compile_commands.json"
    }
  ],
  "version": 4
