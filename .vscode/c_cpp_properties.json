        "${workspaceFolder}/balloon-project-stm32mx/Core/Inc",
        "${workspaceFolder}/balloon-project-stm32mx/App/Inc",
        "${workspaceFolder}/balloon-project-stm32mx/Drivers/STM32F4xx_HAL_Driver/Inc",
        "${workspaceFolder}/balloon-project-stm32mx/Drivers/STM32F4xx_HAL_Driver/Inc/Legacy",
        "${workspaceFolder}/balloon-project-stm32mx/Drivers/CMSIS/Device/ST/STM32F4xx/Include",
        "${workspaceFolder}/balloon-project-stm32mx/Drivers/CMSIS/Include"
