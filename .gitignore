# =============================================================================
# Balloon project — .gitignore
# =============================================================================

# --- OS / junk ---
.DS_Store
.localized
__MACOSX/
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini
Icon[]

# --- Editors / IDE (local caches & personal overrides) ---
# Clangd index cache (regenerated automatically; do not commit)
.cache/
**/.cache/

# Generated IntelliSense DB — absolute machine paths; regenerate with:
#   make -C balloon-project-stm32mx compile_commands
compile_commands.json
**/compile_commands.json

# JetBrains / Eclipse / CubeIDE local state
.idea/
*.user
*.suo
*.workspace
*.launch
.settings/
RemoteSystemsTempFiles/

# Optional: keep shared team VS Code / clangd configs committed (.vscode/, .clangd).
# Uncomment the next line only if you want IDE settings to stay fully local:
# .vscode/

# --- STM32 firmware build artifacts ---
# Regenerate with `make` in balloon-project-stm32mx/
balloon-project-stm32mx/build/
*.o
*.d
*.elf
*.hex
*.bin
*.map
*.lst
*.srec
*.a
*.lib

# --- KiCad (https://www.kicad.org/help/file-formats/) ---
# Temporary / backup files
*.000
*.bak
*.bck
*.kicad_pcb-bak
*.kicad_sch-bak
*-backups
*-cache*
*-bak
*-bak*
*~
~*
_autosave-*
\#auto_saved_files\#
*.tmp
*-save.pro
*-save.kicad_pcb
fp-info-cache
~*.lck

# Local project / history
.history
*.kicad_prl

# Netlists / autorouter exports
*.net
*.dsn
*.ses

# Exported BOM / reports (re-export from KiCad as needed)
*.xml
*.csv

# Archived backups (KiCad 6+)
**/*-backups/*.zip
